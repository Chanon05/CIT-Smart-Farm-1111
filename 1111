<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Panel Launcher</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d1013;
    --surface: #14181c;
    --surface-hover: #1a1f24;
    --line: #232a30;
    --text: #e9edf0;
    --text-muted: #7c8791;
    --amber: #ffb020;
    --teal: #4cc9c0;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    position: relative;
    overflow: hidden;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    pointer-events: none;
  }

  .header {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.01em;
  }

  .notice {
    position: relative;
    z-index: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    max-width: 480px;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .grid {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    width: 320px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .panel:hover {
    background: var(--surface-hover);
    border-color: var(--panel-accent);
    transform: translateY(-2px);
  }

  .panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .channel {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--panel-accent);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--panel-accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--panel-accent) 55%, transparent); }
    70%  { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .panel-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
  }

  .panel-sub {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .panel-btn {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: #0d1013;
    background: var(--panel-accent);
    border: none;
    border-radius: 8px;
    padding: 11px 0;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .panel-btn:hover { opacity: 0.88; }

  .panel-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .panel.preview { --panel-accent: var(--amber); }
  .panel.control { --panel-accent: var(--teal); }

  .actions-row {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }

  .abtn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 18px;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .abtn:hover { border-color: var(--text-muted); }

  .status-msg {
    margin-top: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--teal);
    min-height: 16px;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
</style>
</head>
<body>

  <div class="header">
    <div class="eyebrow">CIT KMUTNB · ENET-T</div>
    <div class="title">Panel Launcher</div>
  </div>

  <div class="notice">
    หน้าเว็บนี้ใช้ HTTPS แต่กล้อง/แขนกลเป็น HTTP — เบราว์เซอร์จะบล็อกการฝังหน้าเว็บ (iframe) เสมอ จึงเปิดเป็นหน้าต่างแยกจริงแทน ครั้งแรกอาจต้องกด "อนุญาต pop-up"
  </div>

  <div class="grid">
    <div class="panel preview" id="cardPreview">
      <div class="panel-top">
        <span class="channel">CH-01</span>
        <span class="status"><span class="dot"></span>ONLINE</span>
      </div>
      <div>
        <div class="panel-name">กล้อง</div>
        <div class="panel-sub">Camera preview feed</div>
      </div>
      <button class="panel-btn" onclick="openPanel('preview')">เปิดกล้อง</button>
      <div class="panel-meta">202.44.36.11:9004</div>
    </div>

    <div class="panel control" id="cardControl">
      <div class="panel-top">
        <span class="channel">CH-02</span>
        <span class="status"><span class="dot"></span>ONLINE</span>
      </div>
      <div>
        <div class="panel-name">แขนกล</div>
        <div class="panel-sub">Robotic arm control panel</div>
      </div>
      <button class="panel-btn" onclick="openPanel('control')">เปิดแขนกล</button>
      <div class="panel-meta">202.44.36.11:9000</div>
    </div>
  </div>

  <div class="actions-row">
    <button class="abtn" onclick="openBoth()">เปิดทั้งสองพร้อมกัน (ไม่ทับกัน)</button>
  </div>

  <div class="status-msg" id="statusMsg"></div>

  <script>
    const panels = {
      preview: {
        url: "http://202.44.36.11:9004/doc/page/preview.asp",
        name: "panel_preview",
        label: "กล้อง"
      },
      control: {
        url: "http://202.44.36.11:9000/control?lang=en&channel=prod",
        name: "panel_control",
        label: "แขนกล"
      }
    };

    const openWindows = {};

    // fixed, non-overlapping slots: left half for preview, right half for control
    function getSlot(which) {
      const w = window.screen.availWidth;
      const h = window.screen.availHeight;
      const halfW = Math.floor(w / 2);
      if (which === 'preview') {
        return { left: 0, top: 0, width: halfW - 4, height: h };
      } else {
        return { left: halfW + 4, top: 0, width: halfW - 4, height: h };
      }
    }

    function openPanel(which) {
      const statusMsg = document.getElementById('statusMsg');
      const p = panels[which];
      const slot = getSlot(which);

      // if already open, just focus it instead of opening a duplicate
      const existing = openWindows[which];
      if (existing && !existing.closed) {
        existing.focus();
        statusMsg.textContent = "หน้าต่าง " + p.label + " เปิดอยู่แล้ว — นำขึ้นหน้าสุดให้แล้ว";
        statusMsg.style.color = "#4cc9c0";
        return;
      }

      const win = window.open(
        p.url,
        p.name,
        `left=${slot.left},top=${slot.top},width=${slot.width},height=${slot.height},resizable=yes,scrollbars=yes`
      );

      if (!win) {
        statusMsg.textContent = "เบราว์เซอร์บล็อก pop-up — กรุณาอนุญาต pop-up สำหรับเว็บนี้แล้วลองใหม่";
        statusMsg.style.color = "#ffb020";
        return;
      }

      openWindows[which] = win;
      statusMsg.textContent = "เปิดหน้าต่าง " + p.label + " แล้ว";
      statusMsg.style.color = "#4cc9c0";
    }

    function openBoth() {
      openPanel('preview');
      setTimeout(() => openPanel('control'), 150);
    }
  </script>

</body>
</html>
